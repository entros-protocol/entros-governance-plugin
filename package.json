{
  "name": "entros-governance-plugin",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "11.12.1"
  },
  "scripts": {
    "fixtures:generate": "node --import tsx scripts/generate-test-fixtures.ts",
    "fixtures:verify": "node scripts/verify-fixtures.mjs",
